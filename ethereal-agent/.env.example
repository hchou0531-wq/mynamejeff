# ---- Telegram ----
# From @BotFather on Telegram after /newbot
TELEGRAM_BOT_TOKEN=

# Your numeric Telegram user ID (NOT your @username). Get it from @userinfobot.
# Comma-separate to allow more than one operator.
TELEGRAM_ALLOWED_USER_ID=

# ---- Ethereal ----
# Base URL of the Ethereal API, including /api
ETHEREAL_API_URL=http://localhost:3000/api

# Admin bearer token. Ethereal uses the admin user's id as its token, so this is the
# `id` field of the admin user document. Treat it like a password.
ETHEREAL_API_KEY=

# ---- AI (optional) ----
# Anthropic API key. If unset, the agent falls back to deterministic analysis computed
# from real data — every number stays real either way.
AI_API_KEY=
AI_MODEL=claude-sonnet-5

# ---- Notifications ----
# How often to poll Ethereal for toy-code orders awaiting fulfillment (seconds).
# Set to 0 to disable background notifications.
NOTIFY_POLL_SECONDS=120

# ---- Morning brief ----
# Local time for the daily DM (revenue + orders to fulfill). -1 disables it.
DAILY_BRIEF_HOUR=9
DAILY_BRIEF_MINUTE=0
# If the machine was asleep at that time, still send within this many hours.
DAILY_BRIEF_CATCHUP_HOURS=6
