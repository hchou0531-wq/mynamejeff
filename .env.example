# --- Database (required for the app to function at all) ---
MONGO_URL=
DB_NAME=

# --- Admin account (seeded into the DB on first run) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Secret slug used in the admin discord-dashboard URL path
ADMIN_DASHBOARD_SECRET=
# Encrypts TOTP (authenticator app) secrets at rest in the database. Never commit this;
# losing it means every enrolled authenticator has to be re-set-up.
TOTP_ENCRYPTION_KEY=

# --- Crypto payments (BlockBee) ---
BLOCKBEE_API_KEY=
BLOCKBEE_RECEIVE_CURRENCY=

# --- Discord bot ---
DISCORD_PUBLIC_KEY=
BOT_SHARED_SECRET=

# --- Roblox integration ---
ROBLOX_ACCESS_TOKEN=
ROBLOX_COOKIE=
ROBLOX_OPENCLOUD_KEY=

# --- App / CORS ---
NEXT_PUBLIC_BASE_URL=
CORS_ORIGINS=*
# Canonical public URL of this deployment — used for links/images baked into outgoing
# EMAIL, the BlockBee payment webhook's callback/redirect URLs, and Discord's registered
# interactions endpoint. All three need a URL that's still correct long after the request
# that triggered them is gone, so none of them are ever derived from the request's Host
# header: anyone can trigger a verification email or a checkout, so a forged Host would
# otherwise produce a real Ethereal email, or a real payment webhook, pointing at an
# attacker's site instead of here.
#
# ON VERCEL: leave this blank. The app reads Vercel's own VERCEL_PROJECT_PRODUCTION_URL
# automatically — correct on day one with zero setup, and it keeps itself correct if you
# add a custom domain later under Vercel → Settings → Domains, with no redeploy and no
# env var edit needed. Only set APP_URL to override that (a domain not registered with
# Vercel, a non-Vercel host, or pinning to something specific on purpose).
#
# NOT ON VERCEL (self-hosted, another platform): set this — there's no automatic
# detection outside Vercel, so without it every link above falls back to the request's
# Host header, which is NOT safe for any of the three uses above.
#
# Must be an absolute URL with a scheme, e.g. https://yourdomain.com — a bare domain like
# "yourdomain.com" is invalid and is rejected with a clear log line rather than silently
# producing a broken link.
APP_URL=

# --- Email verification (signup / anti-mass-registration) ---
# Transactional email provider — Resend (https://resend.com). Get an API key from the
# Resend dashboard and verify a sending domain there before setting EMAIL_FROM to an
# address on it. If unset, verification emails simply fail to send (logged server-side)
# rather than crashing signup.
RESEND_API_KEY=
EMAIL_FROM=Ethereal <noreply@yourdomain.com>
# Minutes a verification code stays valid after being issued.
VERIFICATION_CODE_EXPIRATION_MINUTES=10
# Minimum seconds a user must wait between two verification-email sends.
VERIFICATION_RESEND_COOLDOWN_SECONDS=60
# Wrong codes allowed against one issued code before it's invalidated and a new one is required.
MAX_VERIFICATION_ATTEMPTS=5
# Verification emails allowed per email address per hour (covers both initial send and resends).
MAX_VERIFICATION_EMAILS_PER_HOUR=3
# Signup attempts allowed per IP per hour / per day.
MAX_SIGNUPS_PER_IP_PER_HOUR=5
MAX_SIGNUPS_PER_IP_PER_DAY=20
# Hours an unverified account is kept before it's automatically deleted (MongoDB TTL index).
UNVERIFIED_ACCOUNT_TTL_HOURS=24
# Set to "false" to skip the built-in CAPTCHA on signup (e.g. for automated tests). Never
# disable this in production — it's the primary bot-signup defense alongside rate limiting.
ENABLE_CAPTCHA=true
